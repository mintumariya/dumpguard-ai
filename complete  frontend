                    <a href="#analytics" onclick="showAnalyticsPage()" class="text-gray-700 hover:text-blue-600 font-medium transition-colors">Analytics</a>
                    <a href="#alerts" onclick="showAlertsPage()" class="text-gray-700 hover:text-blue-600 font-medium transition-colors">Alerts</a>
                </div>
                <button class="bg-blue-600 text-white px-4 py-2 rounded-lg hover:bg-blue-700 transition-colors" onclick="showLoginPage()">
                    Login
