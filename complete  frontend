            activeButton.classList.add('border-red-500', 'text-red-600');
            
            // Show/hide alerts based on filter
            allAlerts.forEach(alert => {
                if (type === 'all') {
                    alert.style.display = 'block';
                } else if (type === 'critical') {
                    alert.style.display = alert.classList.contains('critical') ? 'block' : 'none';
                } else if (type === 'dogs') {
