        function drawDogAttacksChart() {
            const canvas = document.getElementById('dogAttacksChart');
            if (!canvas) return;
            
            const ctx = canvas.getContext('2d');
            const data = [8, 6, 4, 5]; // Zone A, B, C, D
            const colors = ['#ef4444', '#f97316', '#eab308', '#3b82f6'];
            const labels = ['Zone A', 'Zone B', 'Zone C', 'Zone D'];
            
            // Clear canvas
            ctx.clearRect(0, 0, canvas.width, canvas.height);
            
            // Draw bar chart
            const barWidth = 60;
            const barSpacing = 80;
            const maxValue = Math.max(...data);
            const chartHeight = 200;
            const startX = 50;
            const startY = 250;
            
            data.forEach((value, index) => {
                const barHeight = (value / maxValue) * chartHeight;
                const x = startX + index * barSpacing;
                const y = startY - barHeight;
                
                // Draw bar
                ctx.fillStyle = colors[index];
                ctx.fillRect(x, y, barWidth, barHeight);
                
                // Draw value on top
                ctx.fillStyle = '#374151';
                ctx.font = '14px sans-serif';
                ctx.textAlign = 'center';
                ctx.fillText(value, x + barWidth/2, y - 10);
                
                // Draw label
                ctx.fillText(labels[index], x + barWidth/2, startY + 20);
            });
            
            // Draw title
            ctx.fillStyle = '#1f2937';
            ctx.font = 'bold 16px sans-serif';
            ctx.textAlign = 'center';
            ctx.fillText('Dog Attacks by Zone', canvas.width/2, 30);
        }

        function drawStrayDogsChart() {
            const canvas = document.getElementById('strayDogsChart');
            if (!canvas) return;
            
            const ctx = canvas.getContext('2d');
            const data = [45, 38, 32, 41]; // Zone A, B, C, D
            const colors = ['#ef4444', '#f97316', '#eab308', '#3b82f6'];
            const total = data.reduce((a, b) => a + b, 0);
            
            // Clear canvas
            ctx.clearRect(0, 0, canvas.width, canvas.height);
            
            // Draw pie chart
            const centerX = canvas.width / 2;
            const centerY = canvas.height / 2;
            const radius = 80;
            
            let currentAngle = -Math.PI / 2; // Start from top
            
            data.forEach((value, index) => {
                const sliceAngle = (value / total) * 2 * Math.PI;
                
                // Draw slice
                ctx.beginPath();
                ctx.moveTo(centerX, centerY);
                ctx.arc(centerX, centerY, radius, currentAngle, currentAngle + sliceAngle);
                ctx.closePath();
                ctx.fillStyle = colors[index];
                ctx.fill();
                
                // Draw percentage
                const textAngle = currentAngle + sliceAngle / 2;
                const textX = centerX + Math.cos(textAngle) * (radius * 0.7);
                const textY = centerY + Math.sin(textAngle) * (radius * 0.7);
                
                ctx.fillStyle = 'white';
                ctx.font = 'bold 12px sans-serif';
                ctx.textAlign = 'center';
                const percentage = Math.round((value / total) * 100);
                ctx.fillText(percentage + '%', textX, textY);
currentAngle += sliceAngle;
            });
            
            // Draw title
            ctx.fillStyle = '#1f2937';
            ctx.font = 'bold 16px sans-serif';
            ctx.textAlign = 'center';
            ctx.fillText('Stray Dogs Distribution', centerX, 30);
        }

        function drawWasteSeverityChart() {
            const canvas = document.getElementById('wasteSeverityChart');
            if (!canvas) return;
            
            const ctx = canvas.getContext('2d');
            const data = [15, 28, 34, 12]; // Critical, High, Medium, Low
            const colors = ['#dc2626', '#ef4444', '#f97316', '#eab308'];
            const labels = ['Critical', 'High', 'Medium', 'Low'];
            
            // Clear canvas
            ctx.clearRect(0, 0, canvas.width, canvas.height);
            
            // Draw horizontal bar chart
            const barHeight = 40;
            const barSpacing = 60;
            const maxValue = Math.max(...data);
            const chartWidth = 250;
            const startX = 80;
            const startY = 60;
            
            data.forEach((value, index) => {
                const barWidth = (value / maxValue) * chartWidth;
                const y = startY + index * barSpacing;
                
                // Draw bar
                ctx.fillStyle = colors[index];
                ctx.fillRect(startX, y, barWidth, barHeight);
                
                // Draw value
                ctx.fillStyle = '#374151';
                ctx.font = '12px sans-serif';
                ctx.textAlign = 'left';
                ctx.fillText(value + ' sites', startX + barWidth + 10, y + barHeight/2 + 4);
                
                // Draw label
                ctx.textAlign = 'right';
                ctx.fillText(labels[index], startX - 10, y + barHeight/2 + 4);
            });
            
            // Draw title
            ctx.fillStyle = '#1f2937';
            ctx.font = 'bold 16px sans-serif';
            ctx.textAlign = 'center';
            ctx.fillText('Waste Dumping Severity', canvas.width/2, 30);
        }

        function drawTrendsChart() {
            const canvas = document.getElementById('trendsChart');
            if (!canvas) return;
            
            const ctx = canvas.getContext('2d');
            
            // Sample data for 6 months
            const months = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun'];
            const strayDogsData = [180, 165, 170, 155, 160, 156];
            const wasteDumpsData = [65, 72, 68, 78, 85, 89];
            
            // Clear canvas
            ctx.clearRect(0, 0, canvas.width, canvas.height);
            
            const chartWidth = 300;
            const chartHeight = 180;
            const startX = 50;
            const startY = 220;
            const pointSpacing = chartWidth / (months.length - 1);
            
            // Draw grid lines
            ctx.strokeStyle = '#e5e7eb';
            ctx.lineWidth = 1;
            for (let i = 0; i <= 5; i++) {
                const y = startY - (i * chartHeight / 5);
                ctx.beginPath();
                ctx.moveTo(startX, y);
                ctx.lineTo(startX + chartWidth, y);
                ctx.stroke();
            }
            
            // Draw stray dogs line
            ctx.strokeStyle = '#f97316';
            ctx.lineWidth = 3;
            ctx.beginPath();
            strayDogsData.forEach((value, index) => {
                const x = startX + index * pointSpacing;
                const y = startY - ((value - 140) / 60) * chartHeight; // Normalize to chart height
                if (index === 0) {
                    ctx.moveTo(x, y);
                } else {
                    ctx.lineTo(x, y);
                }
                
                // Draw point
                ctx.fillStyle = '#f97316';
                ctx.beginPath();
                ctx.arc(x, y, 4, 0, 2 * Math.PI);
                ctx.fill();
            });
            ctx.stroke();
            
            // Draw waste dumps line
            ctx.strokeStyle = '#ef4444';
            ctx.lineWidth = 3;
            ctx.beginPath();
            wasteDumpsData.forEach((value, index) => {
                const x = startX + index * pointSpacing;
                const y = startY - ((value - 60) / 30) * chartHeight; // Normalize to chart height
                if (index === 0) {
                    ctx.moveTo(x, y);
                } else {
                    ctx.lineTo(x, y);
                }
                
                // Draw point
                ctx.fillStyle = '#ef4444';
                ctx.beginPath();
                ctx.arc(x, y, 4, 0, 2 * Math.PI);
                ctx.fill();
            });
            ctx.stroke();
            
            // Draw month labels
            ctx.fillStyle = '#374151';
            ctx.font = '12px sans-serif';
            ctx.textAlign = 'center';
            months.forEach((month, index) => {
                const x = startX + index * pointSpacing;
                ctx.fillText(month, x, startY + 20);
            });
            
            // Draw title
            ctx.fillStyle = '#1f2937';
            ctx.font = 'bold 16px sans-serif';
            ctx.textAlign = 'center';
            ctx.fillText('6-Month Trends', canvas.width/2, 30);
        }

        // Start real-time updates
        setInterval(updateCounts, 5000);
        
        // Smooth scrolling for navigation
        document.querySelectorAll('a[href^="#"]').forEach(anchor => {
            anchor.addEventListener('click', function (e) {
                e.preventDefault();
                const target = document.querySelector(this.getAttribute('href'));
                if (target) {
                    target.scrollIntoView({
                        behavior: 'smooth',
                        block: 'start'
                    });
                }
            });
        });
    </script>
