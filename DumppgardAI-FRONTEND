    <script>
        // Simulate real-time data updates
        function updateCounts() {
            const dogCount = document.getElementById('dogCount');
            const wasteCount = document.getElementById('wasteCount');
            const alertCount = document.getElementById('alertCount');
            
            // Simulate random updates
            if (Math.random() > 0.7) {
                dogCount.textContent = parseInt(dogCount.textContent) + Math.floor(Math.random() * 2);
            }
            if (Math.random() > 0.8) {
                wasteCount.textContent = parseInt(wasteCount.textContent) + Math.floor(Math.random() * 2);
            }
            if (Math.random() > 0.6) {
                alertCount.textContent = parseInt(alertCount.textContent) + Math.floor(Math.random() * 3);
            }
        }

        // Toggle detection switches
        function toggleDetection(button, type) {
            const isActive = button.classList.contains('bg-green-500');
            const span = button.querySelector('span');
            
            if (isActive) {
                button.classList.remove('bg-green-500');
                button.classList.add('bg-gray-300');
                span.classList.remove('translate-x-6');
                span.classList.add('translate-x-1');
            } else {
                button.classList.remove('bg-gray-300');
                button.classList.add('bg-green-500');
                span.classList.remove('translate-x-1');
                span.classList.add('translate-x-6');
            }
            
            // Show feedback
            showNotification(${type.charAt(0).toUpperCase() + type.slice(1)} detection ${isActive ? 'disabled' : 'enabled'});
        }

        // Action buttons
        function generateReport() {
            showNotification('📊 Daily report generated successfully!');
        }

        function dispatchTeam() {
            showNotification('🚐 Response team dispatched to Zone B');
        }

        function exportData() {
            showNotification('💾 Detection data exported to CSV');
        }

        // Notification system
        function showNotification(message) {
            const notification = document.createElement('div');
            notification.className = 'fixed top-4 right-4 bg-green-500 text-white px-6 py-3 rounded-lg shadow-lg z-50 transform translate-x-full transition-transform';
            notification.textContent = message;
            document.body.appendChild(notification);
            
            setTimeout(() => {
                notification.classList.remove('translate-x-full');
            }, 100);
            
            setTimeout(() => {
                notification.classList.add('translate-x-full');
                setTimeout(() => {
                    document.body.removeChild(notification);
                }, 300);
            }, 3000);
        }

        // Start real-time updates
        setInterval(updateCounts, 5000);
        
        // Smooth scrolling for navigation
        document.querySelectorAll('a[href^="#"]').forEach(anchor => {
            anchor.addEventListener('click', function (e) {
                e.preventDefault();
                const target = document.querySelector(this.getAttribute('href'));
                if (target) {
                    target.scrollIntoView({
                        behavior: 'smooth',
                        block: 'start'
                    });
                }
            });
        });
    </script>
